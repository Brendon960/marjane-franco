# URL da API. Deixe VAZIO (recomendado, inclusive em produção): o site chama /api no mesmo domínio.
# Em desenvolvimento o Vite encaminha /api para a API local. O login do painel exige API no
# mesmo domínio do site (cookie SameSite=Strict) — veja README > Deploy.
VITE_API_URL=

# Domínio público do site (usado na URL canônica de SEO), ex.: https://www.seudominio.com.br
VITE_SITE_URL=
