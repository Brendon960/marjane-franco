# Connection string do PostgreSQL (Neon, Supabase etc.) — substitua USUARIO, SENHA, HOST e BANCO.
# Em Neon/Supabase use ?sslmode=require. Nunca versione a URL real.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require"

PORT=3333
# Vazio = 127.0.0.1 em desenvolvimento (só esta máquina) e 0.0.0.0 em produção
HOST=

# Origem EXATA do site (CORS/CSRF). Em produção, o domínio real, ex.: https://www.seudominio.com.br
# Várias: separe por vírgula. "*" não é aceito.
WEB_ORIGIN=http://localhost:5173

# Proxies confiáveis para ler o IP real do X-Forwarded-For (rate limit e auditoria):
#   false = nenhum (API exposta diretamente) · 1 = um proxy na frente (Render, Railway, Nginx…)
#   2 = CDN + balanceador · ou lista de IPs/CIDR do proxy, ex.: 10.0.0.0/8
# NUNCA use um valor maior que o número real de proxies: o cliente poderia forjar o próprio IP.
TRUST_PROXY=false

# Em produção: production (ativa cookie Secure/__Host- do login)
NODE_ENV=development

# ---------------------------------------------------------------------------
# E-mail de confirmação ao cliente (SMTP) — enviado quando a Dra. Marjane confirma
# Deixe em branco para manter desligado. NUNCA coloque a senha no código ou no site.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
#        SMTP_USER=seu@gmail.com e SMTP_PASS = "senha de app" (não a senha normal)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remetente exibido para a cliente (opcional; padrão = SMTP_USER), ex.: "Dra. Marjane Franco <contato@seudominio.com.br>"
EMAIL_FROM=
# Para onde vão as respostas da cliente (opcional; padrão = ADMIN_EMAIL)
EMAIL_REPLY_TO=
# E-mail do administrador do sistema
ADMIN_EMAIL=
# WhatsApp da clínica mostrado nos e-mails como contato (55 + DDD + número, ex.: 5531999999999)
CLINIC_WHATSAPP_NUMBER=
